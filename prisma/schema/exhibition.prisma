model Exhibition {
  id   String @id @default(uuid(7))
  slug String @unique
  name String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  venue     String   @default("")

  paid  Boolean @default(false)
  price Int     @default(0)

  summary String @db.Text
  content String @db.Text

  thumbnail String?
  gallery   String[] @default([])

  artists       ExhibitionArtist[]
  featured      ExhibitionArtwork[]
  registrations ExhibitionRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([updatedAt])
  @@map("exhibitions")
}

model ExhibitionArtist {
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  artistId String
  artist   Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@id([exhibitionId, artistId])
  @@index([artistId])
  @@map("exhibition_artists")
}

model ExhibitionArtwork {
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)

  artworkId String
  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)

  position Int @default(0)

  @@id([exhibitionId, artworkId])
  @@index([artworkId])
  @@map("exhibition_artworks")
}
