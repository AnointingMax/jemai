model Artwork {
  id         String @id @default(uuid(7))
  slug       String @unique
  title      String
  medium     String
  year       String
  /// Free text, e.g. "180 × 240 cm".
  dimensions String
  summary    String @db.Text
  story      String @default("") @db.Text

  curatorsPick Boolean @default(false)

  thumbnail String?
  gallery   String[] @default([])

  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)
  artistId String?

  enquiries Enquiry[]
  featured  ExhibitionArtwork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([medium])
  @@index([curatorsPick])
  @@index([updatedAt])
  @@map("artworks")
}
