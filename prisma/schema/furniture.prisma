model Furniture {
  id            String @id @default(uuid(7))
  slug          String @unique
  name          String
  category      String
  price         Int
  stock         Int    @default(0)
  summary       String @db.Text
  description   String @db.Text
  timeline      String @db.Text
  customization String @db.Text

  thumbnail String?
  /// The detail frame's thumbnail rail, in the order it draws them. Sources
  /// only — the picker's file name and byte size are authoring detail and are
  /// not worth a row each.
  gallery   String[] @default([])

  variants FurnitureVariant[]
  orders   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([updatedAt])
  @@map("furniture")
}

model FurnitureVariant {
  id          String    @id @default(uuid(7))
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)

  size   String @default("")
  colour String

  quantity Int @default(0)

  position Int @default(0)

  orders OrderItem[]

  @@index([furnitureId])
  @@map("furniture_variants")
}
