model Artist {
  id   String @id @default(uuid(7))
  slug String @unique
  name String

  bio      String  @default("") @db.Text
  portrait String?

  artworks    Artwork[]
  exhibitions ExhibitionArtist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("artists")
}
